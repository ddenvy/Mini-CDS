<UserControl x:Class="MiniCds.Wpf.Views.LiveChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MiniCds.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Control Panel -->
        <GroupBox Grid.Row="0" Header="Acquisition Control" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Sample:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding AvailableSamples}"
                          SelectedItem="{Binding SelectedSample}"
                          DisplayMemberPath="Name"
                          Margin="0,0,10,0"/>
                
                <Button Grid.Column="2" Content="Start" 
                        Command="{Binding StartAcquisitionCommand}"
                        Margin="0,0,5,0" Padding="15,5"/>
                <Button Grid.Column="3" Content="Stop" 
                        Command="{Binding StopAcquisitionCommand}"
                        Padding="15,5"/>
            </Grid>
        </GroupBox>

        <!-- Chromatogram Canvas -->
        <GroupBox Grid.Row="1" Header="Chromatogram">
            <Grid>
                <Canvas x:Name="ChromatogramCanvas" 
                        Background="White"
                        ClipToBounds="True"/>
                
                <!-- Axes -->
                <Line X1="50" Y1="50" X2="50" Y2="550" Stroke="Black" StrokeThickness="2"/>
                <Line X1="50" Y1="550" X2="950" Y2="550" Stroke="Black" StrokeThickness="2"/>
                
                <!-- Axis Labels -->
                <TextBlock Text="Time (s)" Canvas.Left="450" Canvas.Top="560" FontSize="12"/>
                <TextBlock Text="Intensity" Canvas.Left="10" Canvas.Top="280" FontSize="12">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- Status Panel -->
        <GroupBox Grid.Row="2" Header="Status" Margin="0,10,0,0">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Sample: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentSampleName}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Status: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding IsAcquiring, Converter={StaticResource BoolToStringConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Peaks: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding PeakCount}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>