<Window x:Class="MiniCds.Wpf.Views.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Audit Trail" Height="600" Width="1100"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="10">
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Content="Refresh"
                    Click="OnRefreshClick" Padding="15,5" Margin="0,0,10,0"/>
            <Button x:Name="VerifyButton" Content="Verify Integrity"
                    Click="OnVerifyClick" Padding="15,5" Margin="0,0,10,0"/>
            <TextBlock x:Name="VerifyResultText" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Audit Grid -->
        <DataGrid x:Name="AuditGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF5F5F5"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Timestamp (UTC)"
                                    Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="150"/>
                <DataGridTextColumn Header="User" Binding="{Binding ActorUsername}" Width="120"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110"/>
                <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="100"/>
                <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="80"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                <DataGridTextColumn Header="Signature" Binding="{Binding SignatureId}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
