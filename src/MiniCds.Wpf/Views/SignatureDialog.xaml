<Window x:Class="MiniCds.Wpf.Views.SignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MiniCds.Wpf.Converters"
        mc:Ignorable="d"
        Title="Electronic Signature" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Electronic Signature (21 CFR Part 11)"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="UsernameBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     Height="28" Padding="5,3"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PasswordBox"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                         Height="28" Padding="5,3"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Meaning" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <ComboBox ItemsSource="{Binding AvailableMeanings}"
                      SelectedItem="{Binding SelectedMeaning}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                      Height="28" Padding="5,3"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Reason (required)" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     Height="60" Padding="5,3"
                     AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock x:Name="ErrorTextBlock"
                       Text="{Binding ErrorMessage}"
                       Foreground="Red" Margin="0,0,0,10"
                       Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Sign"
                        Command="{Binding SignCommand}"
                        IsDefault="True"
                        Width="80" Height="30"
                        Margin="0,0,10,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Width="80" Height="30"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
